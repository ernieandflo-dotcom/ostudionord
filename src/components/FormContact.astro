---
// Formulaire de contact (Formspree), avec honeypot et consentement Loi 25. Tutoiement.
// Phase : P1 (étape h)
//
// Même modèle que FormPartenariat : aucun JavaScript, le navigateur envoie le formulaire
// directement à Formspree. L'adresse est dans src/lib/formulaires.ts (FORMSPREE.contact,
// placeholder à remplacer avant le lancement).
// Noms des champs : ce sont les intitulés que tu verras dans le courriel de Formspree.
// « email » est le nom attendu par Formspree pour pouvoir répondre directement au courriel.
// Pas de téléphone ni de pièce jointe : on ne collecte que le nécessaire (Loi 25).
// Les partenariats d'entreprise passent par /partenaires/#partenariat (pas dans cette liste).
import { FORMSPREE, estPlaceholder } from '../lib/formulaires';

const action = FORMSPREE.contact;
// Avertit dans la console du build tant que l'adresse est un placeholder.
estPlaceholder('contact');

// Choix du champ « Sujet », regroupés (<optgroup>). Valeurs envoyées telles quelles à Formspree.
const SUJETS = [
  {
    groupe: 'Collaboration',
    choix: [
      'Collaboration · artiste (voix)',
      'Collaboration · beatmaker ou instrumentiste',
      'Collaboration · créateur·trice de contenu',
    ],
  },
  {
    groupe: 'Studio Nord',
    choix: [
      'Médias et presse',
      'Proposer un projet ou une idée de contenu',
      'Boutique, cartes-cadeaux ou VIP Pass',
      'Visite du studio (sur rendez-vous)',
      'Candidature spontanée',
    ],
  },
  { groupe: 'Autre', choix: ['Autre'] },
];
---

<form class="form" id="form-contact" action={action} method="POST" accept-charset="UTF-8">

  <!-- Piège à robots (honeypot) de Formspree : invisible, doit rester vide. -->
  <div class="hp" aria-hidden="true">
    <label for="piege-contact">Ne pas remplir</label>
    <input id="piege-contact" type="text" name="_gotcha" value="" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_subject" value="Contact · ostudionord.ca" />
  <input type="hidden" name="source" value="Page Contact" />

  <div class="champs">
    <div class="champ">
      <label for="c-nom">Ton nom ou nom d’artiste</label>
      <input id="c-nom" name="nom" type="text" required autocomplete="name" maxlength="120" />
    </div>

    <div class="champ">
      <label for="c-courriel">Courriel</label>
      <input
        id="c-courriel"
        name="email"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        maxlength="160"
      />
    </div>

    <div class="champ">
      <label for="c-sujet">Sujet</label>
      <select id="c-sujet" name="sujet" required>
        <option value="">Choisis…</option>
        {
          SUJETS.map((g) => (
            <optgroup label={g.groupe}>
              {g.choix.map((c) => (
                <option value={c}>{c}</option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </div>

    <div class="champ">
      <label for="c-lien">Lien <span class="fac">(facultatif)</span></label>
      <!-- type="text" et non "url" : accepte aussi « instagram.com/toncompte » sans https:// -->
      <input
        id="c-lien"
        name="lien"
        type="text"
        inputmode="url"
        autocomplete="url"
        maxlength="200"
        placeholder="instagram.com/toncompte"
        aria-describedby="c-lien-aide"
      />
      <p class="aide" id="c-lien-aide">
        Ton Instagram, ton Spotify, ou un lien d’écoute pour tes sons (aucun fichier joint).
      </p>
    </div>

    <div class="champ large">
      <label for="c-message">Message</label>
      <textarea
        id="c-message"
        name="message"
        required
        rows="6"
        maxlength="2000"
        aria-describedby="c-message-aide"></textarea>
      <p class="aide" id="c-message-aide">2000 caractères au plus.</p>
    </div>
  </div>

  <label class="chk">
    <input type="checkbox" name="consentement" value="oui" required />
    <span>
      J’accepte que Studio Nord utilise ces renseignements uniquement pour répondre à mon message.
      Ils sont transmis par Formspree, un service hébergé aux États-Unis.{' '}
      <a href="/confidentialite/">Confidentialité</a>
    </span>
  </label>

  <div>
    <button class="btn btn-p" type="submit">Envoyer mon message</button>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: 18px;
  }
  .champs {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 700px) {
    .champs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .large { grid-column: 1 / -1; }
  }
  .champ {
    display: grid;
    gap: 6px;
    min-width: 0;
    align-content: start;
  }
  label {
    font-weight: 600;
    font-size: .95rem;
  }
  .fac {
    color: var(--doux);
    font-weight: 400;
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 0 16px;
    border-radius: 14px;
    border: 1px solid var(--contour);
    background: var(--nuit);
    color: var(--texte);
    font: inherit;
  }
  textarea {
    padding: 12px 16px;
    min-height: 150px;
    resize: vertical;
    line-height: 1.5;
  }
  select { appearance: auto; }
  input::placeholder { color: var(--indice); }
  .aide {
    margin: 0;
    color: var(--doux);
    font-size: .85rem;
  }
  .chk {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--doux);
    font-size: .88rem;
    font-weight: 400;
    line-height: 1.45;
  }
  .chk input {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--cyan);
  }
  .chk a { color: var(--glace); }
  .hp {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
