---
// Encadré « Géré par » d'une fiche d'artiste ou de créateur (ex. GT Média).
// Phase : P1 (étape e ; lien principal à l'étape g) — utilisé par /artistes/[slug]/ et /createurs/[slug]/
//
// Le nom devient un lien (nouvel onglet) vers le lien principal du partenaire :
// son site, sinon YouTube, Instagram, Facebook ou TikTok (voir src/lib/partenaires.ts).
import type { CollectionEntry } from 'astro:content';
import { lienPrincipal } from '../lib/partenaires';

interface Props {
  partenaire: CollectionEntry<'partenaires'>;
  /** Texte au-dessus du nom. */
  etiquette?: string;
}

const { partenaire, etiquette = 'Géré par' } = Astro.props;
const { nom, description } = partenaire.data;
const lien = lienPrincipal(partenaire);
---

<aside class="partenaire" aria-labelledby="h-partenaire">
  <p class="mono" id="h-partenaire">{etiquette}</p>
  <p class="p-nom">
    {
      lien ? (
        <a href={lien} target="_blank" rel="noopener">
          {nom} <span aria-hidden="true">↗</span>
          <span class="sr">(nouvel onglet)</span>
        </a>
      ) : (
        nom
      )
    }
  </p>
  <p class="p-desc">{description}</p>
</aside>

<style>
  .partenaire {
    padding: 16px 18px;
    border-radius: var(--r);
    border: 1px solid var(--ligne);
    background: var(--carte);
  }
  .mono { margin: 0; color: var(--cyan); }
  .p-nom {
    margin: 4px 0 6px;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .p-nom a { color: var(--texte); }
  .p-desc {
    margin: 0;
    color: var(--doux);
    font-size: .92rem;
  }
</style>
