---
// Puces de filtre du mur de contenu (îlot JS, aria-pressed).
// Phase : P1 (étape b) — réutilisées sur /contenu/ (étape c, avec le paramètre d'URL)
//
// Sans JavaScript : les puces restent cachées (attribut hidden) et toutes les tuiles
// sont visibles. Le script révèle les puces, puis masque les tuiles d'un autre type.
// Une zone « status » annonce le résultat aux lecteurs d'écran (« 4 contenus affichés »).
//
// Avec `url` : le filtre suit l'adresse de la page.
//   - à l'arrivée, /contenu/?type=coulisses présélectionne « Coulisses »
//     (URLSearchParams lit la partie après le « ? ») ;
//   - au clic, l'adresse est mise à jour sans recharger la page (history.replaceState),
//     pour qu'un mur filtré puisse se partager. Valeur inconnue = « Tout ».
import { LIBELLES, type TypeSortie } from '../lib/sorties';

interface Props {
  /** Types présents dans le mur (une puce par type, en plus de « Tout »). */
  types: TypeSortie[];
  /** id du conteneur des tuiles à filtrer. */
  cible: string;
  /** true : lit et met à jour le paramètre ?type= de l'adresse. */
  url?: boolean;
}

const { types, cible, url = false } = Astro.props;
---

<filtres-mur data-cible={cible} data-url={url ? '' : undefined}>
  <div class="chips" role="group" aria-label="Filtrer par type" hidden data-puces>
    <button type="button" class="chip" aria-pressed="true" data-f="tout">Tout</button>
    {
      types.map((t) => (
        <button type="button" class="chip" aria-pressed="false" data-f={t}>
          {LIBELLES[t].plusieurs}
        </button>
      ))
    }
  </div>
  <p class="sr" role="status" data-statut></p>
</filtres-mur>

<style>
  filtres-mur { display: block; }
  /* Rangée défilante à l'intérieur de son conteneur : la page ne défile jamais de côté. */
  .chips {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    padding: 2px 2px 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips[hidden] { display: none; }
  .chips::-webkit-scrollbar { display: none; }
</style>

<script>
  class FiltresMur extends HTMLElement {
    connectedCallback() {
      const puces = this.querySelector<HTMLElement>('[data-puces]');
      const statut = this.querySelector<HTMLElement>('[data-statut]');
      const mur = document.getElementById(this.dataset.cible ?? '');
      if (!puces || !statut || !mur) return;

      const boutons = [...puces.querySelectorAll<HTMLButtonElement>('button[data-f]')];
      const tuiles = [...mur.querySelectorAll<HTMLElement>('[data-type]')];
      const suitUrl = this.hasAttribute('data-url');
      const existe = (f: string | null): f is string =>
        f !== null && boutons.some((b) => b.dataset.f === f);

      puces.hidden = false; // JS actif : on montre les filtres

      const filtrer = (filtre: string, annoncer = true) => {
        boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === filtre)));
        let n = 0;
        tuiles.forEach((t) => {
          const visible = filtre === 'tout' || t.dataset.type === filtre;
          t.hidden = !visible;
          if (visible) n++;
        });
        if (annoncer) statut.textContent = n === 1 ? '1 contenu affiché' : `${n} contenus affichés`;
      };

      const majUrl = (filtre: string) => {
        const adresse = new URL(location.href);
        if (filtre === 'tout') adresse.searchParams.delete('type');
        else adresse.searchParams.set('type', filtre);
        history.replaceState(history.state, '', adresse);
      };

      boutons.forEach((b) =>
        b.addEventListener('click', () => {
          const filtre = b.dataset.f ?? 'tout';
          filtrer(filtre);
          if (suitUrl) majUrl(filtre);
        }),
      );

      // Présélection depuis l'adresse (?type=coulisses), sans annonce à l'arrivée.
      if (suitUrl) {
        const demande = new URLSearchParams(location.search).get('type');
        if (existe(demande) && demande !== 'tout') filtrer(demande, false);
        else if (demande !== null) majUrl('tout'); // valeur inconnue : on nettoie l'adresse
      }
    }
  }

  customElements.define('filtres-mur', FiltresMur);
</script>
