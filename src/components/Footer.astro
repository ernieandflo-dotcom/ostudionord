---
// Pied de page : coordonnées, navigation secondaire, réseaux, mentions.
// Phase : P1 (étape a ; Contact et FAQ à l'étape h)
import { SITE, NAVIGATION, DISCORD, COURRIEL, ADRESSE, reseauxActifs } from '../data/site';

// Navigation du pied : le menu principal, plus Contact et FAQ (sous-pages d'À propos, étape h).
const liensPied = [
  ...NAVIGATION,
  { label: 'Contact', href: '/a-propos/contact/' },
  { label: 'FAQ', href: '/a-propos/faq/' },
];

const annee = new Date().getFullYear();
const reseaux = [{ nom: 'Discord', url: DISCORD }, ...reseauxActifs];
---

<footer class="pied">
  <div class="wrap foot">
    <div class="coord">
      <strong>{SITE.nom}</strong> · Studio de création
      <address>
        {ADRESSE.rue}, {ADRESSE.quartier} ({ADRESSE.ville}) {ADRESSE.codePostal}<br />
        <a href={`mailto:${COURRIEL}`}>{COURRIEL}</a>
      </address>
    </div>

    <nav aria-label="Pied de page">
      {liensPied.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <ul class="reseaux" aria-label="Réseaux sociaux">
      {
        reseaux.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener">
              {r.nom}
              <span class="sr"> (nouvel onglet)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap mentions mono">
    <span>© {annee} {SITE.nom}</span>
    <a href="/confidentialite/">Confidentialité</a>
  </div>
</footer>

<style>
  .pied {
    margin-top: 24px;
    padding: 36px 0 28px;
    border-top: 1px solid var(--ligne);
    color: var(--doux);
    font-size: .9rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px 36px;
  }
  .coord strong { color: var(--texte); }
  address { font-style: normal; }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-content: start;
  }
  a {
    color: var(--doux);
    text-decoration: none;
  }
  a:hover { color: var(--glace); }
  .coord a {
    color: var(--glace);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .reseaux {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: start;
  }
  .reseaux a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--contour);
    color: var(--texte);
    font-weight: 600;
  }
  .reseaux a:hover { background: rgba(193, 232, 255, .12); }
  /* Petits écrans : espace pour le bouton « Retour en haut » (RetourHaut), qui ne doit
     jamais cacher le dernier lien du pied de page. */
  @media (max-width: 999px) {
    .pied { padding-bottom: calc(80px + env(safe-area-inset-bottom, 0px)); }
  }
  .mentions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
    font-size: .7rem;
  }
</style>
