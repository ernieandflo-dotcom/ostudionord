---
// Carte ou avatar rond d'un artiste, beatmaker ou créateur.
// Phase : P1 (étape b) — réutilisée aux étapes d, e et l (grilles de /artistes/ et /createurs/)
//
// Portrait si fourni, sinon les initiales sur un dégradé.
// Le dégradé dépend de la position dans la rangée (`variante`) : rien à saisir dans le contenu.
// Slot facultatif, sous le sous-titre (ex. pastille « En live » sur /createurs/) : rien
// d'interactif dedans, car toute la carte est déjà un lien.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { DEGRADES, DEGRADE_PALE } from '../lib/personnes';

interface Props {
  href: string;
  nom: string;
  /** Ligne sous le nom : genres, « Beatmaker », catégories… */
  sousTitre?: string;
  initiales: string;
  portrait?: ImageMetadata;
  /** Position dans la rangée : choisit le dégradé (0, 1, 2…). */
  variante?: number;
}

const { href, nom, sousTitre, initiales, portrait, variante = 0 } = Astro.props;

// Dégradés de la maquette B (src/lib/personnes.ts), choisis selon la position.
const i = variante % DEGRADES.length;
const fond = DEGRADES[i];
const clair = i === DEGRADE_PALE; // fond pâle : initiales foncées
---

<a class="av" href={href}>
  <span
    class:list={['rond', { clair }]}
    style={portrait ? undefined : `--bg: ${fond}`}
    aria-hidden="true"
  >
    {
      portrait ? (
        <Image src={portrait} alt="" width={132} height={132} densities={[1, 2]} fit="cover" />
      ) : (
        initiales
      )
    }
  </span>
  <strong>{nom}</strong>
  {sousTitre && <small>{sousTitre}</small>}
  {Astro.slots.has('default') && <span class="extra"><slot /></span>}
</a>

<style>
  .av {
    flex: none;
    width: 132px;
    scroll-snap-align: start;
    text-align: center;
    text-decoration: none;
    color: var(--texte);
    border-radius: 12px;
  }
  .rond {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid transparent;
    background: var(--bg, var(--carte));
    color: var(--glace);
    font-size: 1.5rem;
    font-weight: 800;
    text-shadow: 0 1px 10px rgba(4, 10, 20, .7);
    transition: transform .2s, border-color .2s;
  }
  .rond.clair {
    color: var(--encre);
    text-shadow: none;
  }
  .rond :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .av:hover .rond,
  .av:focus-visible .rond {
    border-color: var(--cyan);
    transform: scale(1.03);
  }
  strong {
    display: block;
    margin-top: 10px;
    font-size: .98rem;
    line-height: 1.2;
  }
  small {
    display: block;
    margin-top: 2px;
    color: var(--doux);
    font-size: .8rem;
    line-height: 1.3;
  }
  .extra {
    display: block;
    margin-top: 8px;
  }
</style>
