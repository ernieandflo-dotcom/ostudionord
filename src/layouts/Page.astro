---
// Gabarit des pages intérieures : Base + en-tête de page (surtitre, titre, intro).
// Phase : P1 (étape a)
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';

interface Props {
  /** Titre affiché dans le h1 et dans l'onglet. */
  title: string;
  /** Petit texte en majuscules au-dessus du titre (ex. « Les visages »). */
  surtitre?: string;
  /** Paragraphe d'introduction sous le titre. */
  intro?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, surtitre, intro, ...meta } = Astro.props;
---

<Base title={title} {...meta}>
  <header class="page-h">
    <div class="wrap">
      {surtitre && <p class="mono surtitre">{surtitre}</p>}
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
    </div>
  </header>
  <slot />
</Base>

<style>
  .page-h { padding: 40px 0 8px; }
  .surtitre {
    margin: 0 0 6px;
    color: var(--cyan);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 8vw, 4.6rem);
    line-height: .92;
    font-weight: 800;
    font-variation-settings: "wdth" 80;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }
  .intro {
    margin: 16px 0 0;
    max-width: 36rem;
    color: var(--doux);
    font-size: 1.05rem;
  }
</style>
