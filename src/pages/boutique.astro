---
// Boutique (maquette C « Lookbook Bluestorm ») : bandeau, onglets collants, merch
// (fiche produit + avis du drop), beats (écoute + M'informer), VIP Pass et cartes-cadeaux.
// Phase : P1 → P3 (étape f)
//
// Données : collections `merch`, `cartesCadeaux`, `beats` et `artistes` (src/content/).
// Réglages : DROP_MERCH et VENTES_BEATS dans src/data/site.ts.
// Aucun JavaScript propre à la page : le choix couleur / vue / taille se fait en CSS
// (ConfigurateurMerch), les onglets sont des ancres. Seuls les lecteurs de beats sont des îlots.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ConfigurateurMerch from '../components/ConfigurateurMerch.astro';
import ListeBeats from '../components/ListeBeats.astro';
import FormInfolettre from '../components/FormInfolettre.astro';
import { COURRIEL, DROP_MERCH } from '../data/site';
import { genresEnTexte, parOrdre } from '../lib/personnes';
import { carteQuiCouvre, formaterPrix, lienCommande } from '../lib/boutique';
import imagePartage from '../assets/merch/merch_Hoodie001-black-f.avif';

// ---------- Merch ----------
const alpha = new Intl.Collator('fr-CA', { sensitivity: 'base', numeric: true });
const merch = (await getCollection('merch')).sort(
  (a, b) => a.data.ordre - b.data.ordre || alpha.compare(a.data.nom, b.data.nom),
);
const produits = merch.filter((p) => p.data.statut !== 'apercu');
const maquettes = merch.filter((p) => p.data.statut === 'apercu').flatMap((p) => p.data.visuels);

// Bandeau : une maquette, la face du premier produit, une autre maquette.
const premier = produits[0]?.data.variantes[0]?.devant;
const bandeau = [
  maquettes[0],
  premier && { image: premier.image, alt: premier.alt },
  maquettes.length > 1 ? maquettes[maquettes.length - 1] : undefined,
].filter((v): v is { image: ImageMetadata; alt: string } => Boolean(v));

// ---------- Beats : un bloc par beatmaker (ordre : parOrdre) ----------
const beats = await getCollection('beats');
const groupes = (
  await getCollection('artistes', (a) => beats.some((b) => b.data.beatmaker.id === a.id))
)
  .sort(parOrdre)
  .map((bm) => ({ bm, beats: beats.filter((b) => b.data.beatmaker.id === bm.id) }));

// ---------- Cartes-cadeaux et VIP Pass (les « masquee » ne sont pas affichées) ----------
const cartes = (await getCollection('cartesCadeaux', (c) => c.data.statut !== 'masquee')).sort(
  (a, b) => a.data.ordre - b.data.ordre || a.data.prix - b.data.prix,
);
const montants = cartes.filter((c) => c.data.genre !== 'pass');
const passes = cartes.filter((c) => c.data.genre === 'pass');

// Suggestion « C'est pour offrir ? » : plus petite carte qui couvre le premier produit.
const prixProduit = produits[0]?.data.prix;
const carteSuggeree = prixProduit ? carteQuiCouvre(prixProduit, cartes) : undefined;

const onglets = [
  { href: '#merch', court: 'Merch', long: 'Merch', actif: produits.length > 0 },
  { href: '#beats', court: 'Beats', long: 'Beats', actif: groupes.length > 0 },
  { href: `#${passes[0]?.id}`, court: 'VIP', long: 'VIP Pass', actif: passes.length > 0 },
  { href: '#cartes-cadeaux', court: 'Cartes', long: 'Cartes-cadeaux', actif: montants.length > 0 },
].filter((o) => o.actif);
---

<Base
  title="Boutique"
  description="Boutique Studio Nord : hoodie Étoile Polaire et merch Bluestorm, beats à écouter, VIP Pass pour nos événements à Québec et cartes-cadeaux."
  image={imagePartage}
  imageAlt="Hoodie Studio Nord noir, vu de face"
  partageCarre
>
  <!-- ═════════ BANDEAU LOOKBOOK ═════════ -->
  <section class="bandeau" aria-labelledby="h-boutique">
    <div class="wrap bandeau-in">
      <div class="bandeau-txt">
        <p class="mono surtitre">Boutique · premier drop {DROP_MERCH.quand}</p>
        <h1 id="h-boutique">Porte l'univers Bluestorm</h1>
        <p class="intro">
          Hoodie, pièces Bluestorm, beats et VIP Pass. Chaque achat finance le prochain tournage.
        </p>
        <div class="actions">
          {produits.length > 0 && <a class="btn blanc" href="#merch">Choisir mon hoodie</a>}
          {montants.length > 0 && <a class="btn btn-g" href="#cartes-cadeaux">Offrir une carte</a>}
        </div>
      </div>
      {
        bandeau.length > 0 && (
          <figure class="lookbook">
            <ul role="list">
              {bandeau.map((v) => (
                <li>
                  <Image src={v.image} alt={v.alt} widths={[240, 480]} sizes="(min-width: 900px) 200px, 30vw" loading="eager" />
                </li>
              ))}
            </ul>
            {maquettes.length > 0 && (
              <figcaption class="mono">Maquettes Bluestorm · sujet à changement</figcaption>
            )}
          </figure>
        )
      }
    </div>
  </section>

  <!-- ═════════ ONGLETS COLLANTS ═════════ -->
  <nav class="onglets" aria-label="Sections de la boutique">
    <div class="wrap">
      <ul role="list">
        {
          onglets.map((o) => (
            <li>
              <a href={o.href} data-cible={o.href.slice(1)}>
                <span class="court" aria-hidden="true">{o.court}</span>
                <span class="long">{o.long}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- ═════════ MERCH ═════════ -->
  {
    produits.length > 0 && (
      <section id="merch" class="ancre sec" aria-labelledby={`h-${produits[0].id}`}>
        <div class="wrap">
          {produits.map((p) => (
            <ConfigurateurMerch produit={p} />
          ))}

          {carteSuggeree && (
            <div class="offrir">
              <div class="offrir-txt">
                {carteSuggeree.data.visuel && (
                  <Image src={carteSuggeree.data.visuel} alt="" width={56} widths={[56, 112]} sizes="56px" />
                )}
                <p>
                  <strong>C'est pour offrir ?</strong>{' '}
                  <span>
                    Une carte-cadeau de {formaterPrix(carteSuggeree.data.prix)} couvre le hoodie, et elle
                    n'expire jamais.
                  </span>
                </p>
              </div>
              <a class="btn btn-g" href={lienCommande(carteSuggeree.data.nom)}>
                Offrir la carte de {formaterPrix(carteSuggeree.data.prix)}
                <span class="sr"> (par courriel)</span>
              </a>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- ═════════ BEATS ═════════ -->
  {
    groupes.length > 0 && (
      <section id="beats" class="ancre sec sec-beats" aria-labelledby="h-beats">
        <div class="wrap">
          <h2 id="h-beats" class="sr">Beats</h2>
          {groupes.map(({ bm, beats: liste }, i) => (
            <div class="beatmaker">
              <div class="bm-infos">
                {bm.data.portrait && (
                  <Image
                    class="bm-portrait"
                    src={bm.data.portrait}
                    alt={bm.data.portraitAlt ?? ''}
                    widths={[300, 600]}
                    sizes="(min-width: 900px) 340px, 40vw"
                  />
                )}
                <p class="mono surtitre">Beatmaker · écoute intégrale</p>
                <h3>Les beats de {bm.data.nom}</h3>
                {bm.data.genres.length > 0 && (
                  <p class="genres">{genresEnTexte(bm.data.genres)}. Les licences arrivent bientôt.</p>
                )}
                <a class="lien" href={`/artistes/${bm.id}/`}>
                  Voir la fiche de {bm.data.nom} <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="bm-liste">
                <ListeBeats beats={liste} avis={i === groupes.length - 1} />
              </div>
            </div>
          ))}

          <div class="avertir">
            <h3>M'avertir quand les licences seront disponibles</h3>
            <FormInfolettre liste="beats" />
          </div>
        </div>
      </section>
    )
  }

  <!-- ═════════ VIP PASS + CARTES-CADEAUX ═════════ -->
  {
    cartes.length > 0 && (
      <section class="sec" aria-label="À offrir">
        <div class="wrap">
          {passes.map((c) => {
            const d = c.data;
            return (
              <article id={c.id} class="ancre vip" aria-labelledby={`h-${c.id}`}>
                <div class="vip-txt">
                  <p class="mono surtitre">
                    Nouveau · {d.statut === 'disponible' ? 'disponible maintenant' : 'bientôt'}
                  </p>
                  <h2 id={`h-${c.id}`}>{d.nom}</h2>
                  {d.details && <p>{d.details} Pour toi, ou à offrir.</p>}
                </div>
                <div class="vip-achat">
                  <p class="vip-prix">{formaterPrix(d.prix)}</p>
                  <p class="mono">Prix de lancement</p>
                  {d.statut === 'disponible' ? (
                    <a class="btn blanc" href={lienCommande(d.nom)}>
                      Commander le {d.nom}
                      <span class="sr"> par courriel</span>
                    </a>
                  ) : (
                    <p class="mono bientot">Bientôt disponible</p>
                  )}
                </div>
              </article>
            );
          })}

          {montants.length > 0 && (
            <div id="cartes-cadeaux" class="ancre cartes-bloc">
              <h2>Cartes-cadeaux</h2>
              <ul class="cartes" role="list">
                {montants.map((c) => {
                  const d = c.data;
                  return (
                    <li class="carte">
                      {d.visuel && (
                        <Image
                          src={d.visuel}
                          alt={d.visuelAlt ?? ''}
                          widths={[400, 800]}
                          sizes="(min-width: 1240px) 400px, (min-width: 700px) 31vw, 92vw"
                        />
                      )}
                      <div class="carte-c">
                        <h3>
                          <span class="sr">Carte-cadeau de </span>
                          {formaterPrix(d.prix)}
                        </h3>
                        {d.details && <p class="details">{d.details}</p>}
                        {d.statut === 'disponible' ? (
                          <a class="lien-commande" href={lienCommande(d.nom)}>
                            Commander<span class="sr"> la {d.nom} par courriel</span>{' '}
                            <span aria-hidden="true">→</span>
                          </a>
                        ) : (
                          <span class="mono">Bientôt disponible</span>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>

              <div class="infos-cartes">
                <div class="bloc">
                  <h3>Comment commander</h3>
                  <ol>
                    <li>Clique sur « Commander » : ton application de courriel s'ouvre avec un message prêt à envoyer.</li>
                    <li>On te répond avec les détails du paiement.</li>
                    <li>On te remet la carte, ou directement à la personne à qui tu l'offres.</li>
                  </ol>
                  <p class="note">
                    Le bouton ne s'ouvre pas ? Écris-nous à <a href={`mailto:${COURRIEL}`}>{COURRIEL}</a>.
                  </p>
                </div>
                <div class="bloc">
                  <h3>Conditions</h3>
                  <ul>
                    <li>Aucune date d'expiration.</li>
                    <li>Utilisable sur le merch (y compris au drop de {DROP_MERCH.par}) et les autres produits Studio Nord.</li>
                    <li>Si le prix d'un produit a changé, tu paies la différence.</li>
                    <li>Si un produit n'existe plus, sa valeur sert pour un autre produit.</li>
                    <li>Non monnayable : non échangeable contre de l'argent, sauf exception prévue par la loi.</li>
                  </ul>
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  .sec { padding: 48px 0; }
  .surtitre { margin: 0 0 8px; color: var(--cyan); }

  /* Le titre ne se cache pas sous l'en-tête et les onglets collants après un clic. */
  .ancre { scroll-margin-top: 172px; }

  /* ---------- Bandeau ---------- */
  .bandeau {
    padding: 28px 0 36px;
    background: linear-gradient(120deg, var(--marine), var(--abysse) 70%);
  }
  .bandeau-in { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 900px) {
    .bandeau-in { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 36px; }
    .bandeau { padding: 48px 0; }
  }
  .bandeau .surtitre { color: var(--glace); }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 9vw, 5rem);
    line-height: .88;
    font-weight: 800;
    font-variation-settings: "wdth" 76;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }
  .intro { margin: 16px 0 22px; max-width: 30rem; color: #c9dcec; font-size: 1.05rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .blanc { background: #fff; color: var(--encre); }
  .blanc:hover { background: var(--glace); }

  .lookbook { margin: 0; }
  .lookbook ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) { .lookbook ul { gap: 12px; } }
  .lookbook :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 14px;
  }
  .lookbook li:nth-child(2) :global(img) { aspect-ratio: 3 / 4.5; }
  .lookbook figcaption { margin-top: 8px; color: #c9dcec; font-size: .7rem; }

  /* ---------- Onglets collants (sous l'en-tête flottant) ---------- */
  .onglets {
    position: sticky;
    top: 84px;
    z-index: 40;
    padding: 10px 0;
  }
  .onglets ul {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 2px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border-radius: 999px;
    border: 1px solid var(--contour);
    background: rgba(12, 29, 54, .96);
    box-shadow: 0 10px 24px rgba(0, 0, 0, .35);
  }
  .onglets a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 8px;
    border-radius: 999px;
    color: var(--texte);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .onglets a:hover { background: #12305a; }
  .long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (min-width: 600px) {
    .court { display: none; }
    .long { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
    .onglets a { font-size: 1.02rem; }
  }
  /* Onglet allumé : celui de la section visée par l'ancre (#merch…), sans JavaScript. */
  :global(main:has(#merch:target)) .onglets a[data-cible="merch"],
  :global(main:has(#beats:target)) .onglets a[data-cible="beats"],
  :global(main:has(#vip-pass:target)) .onglets a[data-cible="vip-pass"],
  :global(main:has(#cartes-cadeaux:target)) .onglets a[data-cible="cartes-cadeaux"] {
    background: var(--cyan);
    color: var(--encre);
  }

  /* ---------- Merch : suggestion de carte ---------- */
  .offrir {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    margin-top: 32px;
    padding: 16px 20px;
    border-radius: var(--r);
    border: 1px dashed var(--contour);
  }
  .offrir-txt { display: flex; gap: 14px; align-items: center; min-width: 0; flex: 1 1 280px; }
  .offrir-txt :global(img) { flex: none; width: 56px; height: 56px; border-radius: 10px; object-fit: cover; }
  .offrir p { margin: 0; }
  .offrir p span { color: var(--doux); }

  /* ---------- Beats ---------- */
  .sec-beats { background: var(--abysse); }
  .beatmaker { display: grid; gap: 24px; }
  .beatmaker + .beatmaker { margin-top: 40px; }
  @media (min-width: 900px) {
    .beatmaker { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 36px; align-items: start; }
  }
  .bm-infos { display: grid; gap: 10px; justify-items: start; }
  .bm-infos .surtitre { margin: 6px 0 0; }
  .bm-infos :global(.bm-portrait) {
    width: 100%;
    max-width: 340px;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r);
  }
  @media (max-width: 899px) {
    .bm-infos :global(.bm-portrait) { max-width: 120px; }
  }
  .bm-infos h3 {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    line-height: .95;
    font-weight: 800;
    font-variation-settings: "wdth" 82;
  }
  .genres { margin: 0; color: var(--doux); }
  .avertir { max-width: 40rem; margin-top: 32px; }
  .avertir h3 { margin: 0 0 12px; font-size: 1.1rem; }

  /* ---------- VIP Pass ---------- */
  .vip {
    display: grid;
    gap: 20px;
    padding: 24px;
    border-radius: 24px;
    background: linear-gradient(120deg, var(--logo), var(--marine) 55%, var(--abysse));
  }
  @media (min-width: 800px) {
    .vip { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: center; padding: 32px; }
  }
  .vip .surtitre { color: var(--glace); }
  .vip h2 {
    margin: 0 0 8px;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: .95;
    font-weight: 800;
    font-variation-settings: "wdth" 78;
  }
  .vip-txt p:last-child { margin: 0; max-width: 32rem; color: #e1eef8; }
  .vip-achat { display: grid; gap: 6px; justify-items: start; }
  .vip-achat .mono { margin: 0 0 8px; color: var(--glace); }
  .vip-prix { margin: 0; font-size: 2.6rem; font-weight: 800; line-height: 1; }
  .bientot { padding: 10px 16px; border-radius: 999px; border: 1px dashed var(--glace); }

  /* ---------- Cartes-cadeaux ---------- */
  .cartes-bloc { margin-top: 44px; }
  .cartes-bloc > h2 {
    margin: 0 0 16px;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    line-height: 1;
    font-weight: 800;
    font-variation-settings: "wdth" 82;
  }
  .cartes {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 700px) {
    .cartes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .carte {
    position: relative;
    overflow: hidden;
    border-radius: var(--r);
    border: 1px solid var(--ligne);
    background: var(--carte);
  }
  .carte:hover { border-color: var(--contour); }
  .carte :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .carte-c {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
  }
  .carte h3 { margin: 0; font-size: 1.5rem; font-weight: 800; }
  .carte .details { flex-basis: 100%; margin: 0; color: var(--doux); font-size: .9rem; }
  /* Toute la carte est cliquable : le lien s'étend sur la carte (pseudo-élément). */
  .lien-commande { color: var(--cyan); font-weight: 700; text-decoration: none; }
  .lien-commande::after { content: ""; position: absolute; inset: 0; }
  .lien-commande:focus-visible { outline: none; }
  .carte:has(.lien-commande:focus-visible) { outline: 2px solid var(--cyan); outline-offset: 3px; }

  .infos-cartes { display: grid; gap: 14px; margin-top: 22px; }
  @media (min-width: 800px) { .infos-cartes { grid-template-columns: 1fr 1fr; } }
  .bloc { padding: 18px 20px; border-radius: var(--r); border: 1px solid var(--ligne); }
  .bloc h3 { margin: 0 0 10px; font-size: 1.1rem; }
  .bloc ol, .bloc ul { margin: 0; padding-left: 1.2rem; color: var(--doux); }
  .bloc li + li { margin-top: 6px; }
  .note { margin: 12px 0 0; color: var(--doux); font-size: .9rem; overflow-wrap: anywhere; }
</style>
