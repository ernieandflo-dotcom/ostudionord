---
// Fiche d'un créateur de contenu : /createurs/<slug>/
// Phase : P1 (étape e)
//
// getStaticPaths() crée une page par fichier de src/content/createurs/ :
// bhnwth.md → /createurs/bhnwth/.
//
// Contenu : en-tête partagé avec les artistes (EnTetePersonne) : pseudo, catégories,
// boutons de diffusion (« Regarder sur Twitch »), autres liens, pastilles « · bientôt » ;
// pastille « En live » et horaire des lives ; bio (Markdown) ; « Géré par » ;
// sorties où le créateur figure ; autres créateurs, ou sinon les artistes ; retour.
// Aucun lecteur Twitch intégré (Loi 25) : de simples liens.
// Données structurées : Person. Partage : type « profile », portrait carré.
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CarteArtiste from '../../components/CarteArtiste.astro';
import EnTetePersonne from '../../components/EnTetePersonne.astro';
import EncadrePartenaire from '../../components/EncadrePartenaire.astro';
import StatutLive from '../../components/StatutLive.astro';
import Tuile from '../../components/Tuile.astro';
import {
  descriptionCreateur,
  liensCreateur,
  parOrdre,
  sousTitreArtiste,
  sousTitreCreateur,
  texteHoraire,
  type Createur,
} from '../../lib/personnes';
import { trierSorties } from '../../lib/sorties';

export async function getStaticPaths() {
  const createurs = await getCollection('createurs');
  return createurs.map((createur) => ({ params: { slug: createur.id }, props: { createur } }));
}

interface Props {
  createur: Createur;
}

const { createur } = Astro.props;
const d = createur.data;

// Rappel au build : bio encore en lorem ipsum.
if (import.meta.env.PROD && /lorem ipsum/i.test(createur.body ?? '')) {
  console.warn(`\n⚠  À FAIRE AVANT LE LANCEMENT : bio en lorem ipsum dans createurs/${createur.id}.md\n`);
}

// Avatar sans portrait : même dégradé que sur /createurs/ (position dans la liste triée).
const tous = (await getCollection('createurs')).sort(parOrdre);
const position = tous.findIndex((c) => c.id === createur.id);
const autres = tous.filter((c) => c.id !== createur.id);
// Pas d'autre créateur : on propose les artistes à la place.
const artistes = autres.length === 0 ? (await getCollection('artistes')).sort(parOrdre) : [];

const sorties = trierSorties(
  await getCollection('sorties', (s) => s.data.createurs.some((r) => r.id === createur.id)),
);

const partenaire = d.partenaire ? await getEntry(d.partenaire) : undefined;
const liens = liensCreateur(createur);
const plages = d.horaire?.plages ?? [];

const { Content } = await render(createur);
const aUneBio = Boolean(createur.body?.trim());

const description = descriptionCreateur(createur);

// ---------- Données structurées (JSON-LD, schema.org Person) ----------
const absolu = (u: string) => new URL(u, Astro.site).href;
const imageLd = d.portrait
  ? await getImage({ src: d.portrait, width: 1080, height: 1080, fit: 'cover', format: 'jpg' })
  : undefined;
const sameAs = [...liens.diffusion, ...liens.autres].map((l) => l.url);
const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.nom,
  ...(d.pseudo && { alternateName: d.pseudo }),
  jobTitle: 'Créateur de contenu',
  url: absolu(Astro.url.pathname),
  description,
  ...(imageLd && { image: absolu(imageLd.src) }),
  ...(d.categories.length > 0 && { knowsAbout: d.categories }),
  ...(sameAs.length > 0 && { sameAs }),
};
// « < » échappé : le texte ne peut pas fermer la balise <script> par accident.
const jsonLd = JSON.stringify(personne).replace(/</g, '\\u003c');
---

<Base
  title={d.nom}
  description={description}
  image={d.portrait}
  imageAlt={d.portraitAlt}
  type="profile"
  partageCarre
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="fiche" aria-labelledby="h-createur">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'Ariane">
        <a href="/createurs/"><span aria-hidden="true">← </span>Tous les créateurs</a>
      </nav>

      <EnTetePersonne
        idTitre="h-createur"
        nom={d.nom}
        etiquette="Créateur de contenu"
        sousLigne={d.pseudo}
        initiales={d.initiales}
        portrait={d.portrait}
        portraitAlt={d.portraitAlt}
        variante={position}
        pastilles={d.categories}
        libellePastilles="Catégories"
        accroche={d.accroche}
        liensPrincipaux={liens.diffusion}
        prefixePrincipal="Regarder sur"
        liens={liens.autres}
        bientot={liens.bientot}
      >
        {
          d.horaire && (plages.length > 0 || d.horaire.note) && (
            <div class="horaire">
              <StatutLive plages={plages} />
              <h2 class="mono" id="h-horaire">Horaire des lives</h2>
              {plages.length > 0 && (
                <ul role="list" aria-labelledby="h-horaire">
                  {plages.map((p) => (
                    <li>{texteHoraire(p)}</li>
                  ))}
                </ul>
              )}
              {d.horaire.note && <p class="note">{d.horaire.note}</p>}
              {plages.length > 0 && <p class="fuseau">Heure du Québec.</p>}
            </div>
          )
        }
      </EnTetePersonne>

      {
        (aUneBio || partenaire) && (
          <div class="apropos">
            {aUneBio && (
              <section class="bio" aria-labelledby="h-bio">
                <h2 id="h-bio" class="mono">À propos</h2>
                <Content />
              </section>
            )}

            {partenaire && <EncadrePartenaire partenaire={partenaire} />}
          </div>
        )
      }
    </div>
  </article>

  <!-- Contenus -->
  {
    sorties.length > 0 ? (
      <section class="sec" aria-labelledby="h-sorties">
        <div class="wrap">
          <div class="sec-h">
            <div>
              <span class="mono">Avec Studio Nord</span>
              <h2 id="h-sorties">Ses contenus</h2>
            </div>
          </div>
          <div class="mur">
            {sorties.map((s) => (
              <Tuile sortie={s} />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="sec" aria-labelledby="h-sorties">
        <div class="wrap">
          <div class="vide">
            <h2 id="h-sorties">Ses contenus</h2>
            <p>Ses premiers contenus avec Studio Nord arrivent bientôt.</p>
            <a class="lien" href="/#infolettre">
              M'avertir des prochaines sorties <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Autres créateurs, ou les artistes -->
  {
    (autres.length > 0 || artistes.length > 0) && (
      <section class="sec" aria-labelledby="h-autres">
        <div class="wrap">
          <div class="sec-h">
            <div>
              <span class="mono">Les visages</span>
              <h2 id="h-autres">
                {autres.length > 0 ? "D'autres créateurs" : 'Découvre aussi nos artistes'}
              </h2>
            </div>
            {autres.length === 0 && (
              <a class="lien" href="/artistes/">
                Les artistes <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
          <ul class="grille-av" role="list">
            {autres.length > 0
              ? autres.map((c) => (
                  <li>
                    <CarteArtiste
                      href={`/createurs/${c.id}/`}
                      nom={c.data.nom}
                      sousTitre={sousTitreCreateur(c)}
                      initiales={c.data.initiales}
                      portrait={c.data.portrait}
                      variante={tous.indexOf(c)}
                    />
                  </li>
                ))
              : artistes.map((a, i) => (
                  <li>
                    <CarteArtiste
                      href={`/artistes/${a.id}/`}
                      nom={a.data.nom}
                      sousTitre={sousTitreArtiste(a)}
                      initiales={a.data.initiales}
                      portrait={a.data.portrait}
                      variante={i}
                    />
                  </li>
                ))}
          </ul>
        </div>
      </section>
    )
  }

  <nav class="retour" aria-label="Retour à la liste des créateurs">
    <div class="wrap">
      <a class="btn btn-p" href="/createurs/">Tous les créateurs</a>
      <a class="btn btn-g" href="/contenu/">Tout le contenu</a>
    </div>
  </nav>
</Base>

<style>
  .fiche { padding: 18px 0 8px; }

  .fil { margin-bottom: 18px; }
  .fil a {
    color: var(--doux);
    font-size: .92rem;
    text-decoration: none;
  }
  .fil a:hover { color: var(--glace); }

  /* Horaire (dans l'en-tête, sous les boutons) */
  .horaire {
    margin-top: 20px;
    max-width: 30rem;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid var(--ligne);
    background: var(--carte);
  }
  .horaire h2 {
    margin: 0 0 6px;
    color: var(--cyan);
    font-weight: 400;
  }
  .horaire :global(statut-live) { margin-bottom: 10px; }
  .horaire ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .horaire li { font-weight: 600; }
  .note,
  .fuseau {
    margin: 6px 0 0;
    color: var(--doux);
    font-size: .88rem;
  }

  /* Bio + partenaire */
  .apropos {
    display: grid;
    gap: 22px;
    margin-top: 36px;
  }
  @media (min-width: 900px) {
    .apropos { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; gap: 40px; }
  }
  .bio { max-width: 46rem; color: var(--doux); padding: 32px 0; }
  .bio h2 { margin: 0 0 8px; color: var(--cyan); font-weight: 400; }
  .bio :global(p) { margin: 0 0 12px; }
  .bio :global(a) { color: var(--glace); }

  .sec { padding: 32px 0; }

  .vide {
    padding: 22px;
    border-radius: var(--r);
    border: 1px dashed var(--contour);
  }
  .vide h2 { margin: 0 0 6px; font-size: 1.3rem; }
  .vide p { margin: 0 0 12px; color: var(--doux); }

  /* .grille-av : classe commune, dans src/styles/global.css */

  .retour { padding: 8px 0 64px; }
  .retour .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
