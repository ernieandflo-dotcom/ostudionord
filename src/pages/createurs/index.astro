---
// Index des créateurs de contenu et live streaming : /createurs/
// Phase : P1 (étape e) · refonte visuelle à l'étape l
//
// Même look que la section « Les artistes » de /artistes/ : surtitre « Créateur de contenu »,
// h2 « Les créateurs », grille d'avatars ronds (CarteArtiste, classe globale .grille-av).
// Carte : portrait, nom, catégories, et pastille « En live » (selon l'horaire) quand le
// créateur a un horaire. Le pseudo, « Géré par … » et le bouton « Regarder sur … » sont sur
// la fiche seulement (une carte est un seul lien : pas de bouton à l'intérieur).
// Bandeaux : « Tu crées du contenu ? » (Discord) et renvoi vers /artistes/.
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import CarteArtiste from '../../components/CarteArtiste.astro';
import StatutLive from '../../components/StatutLive.astro';
import { DISCORD } from '../../data/site';
import { parOrdre, sousTitreCreateur } from '../../lib/personnes';

const createurs = (await getCollection('createurs')).sort(parOrdre);
---

<Page
  title="Créateurs"
  surtitre="Les visages"
  intro="Live streaming, divertissement : les créateurs de contenu qui tournent avec Studio Nord."
  description="Les créateurs de contenu de Studio Nord (Limoilou, Québec) : live streaming et divertissement, avec BHNWTH."
>
  <section aria-labelledby="h-liste">
    <div class="wrap">
      <div class="sec-h">
        <div>
          <span class="mono">Créateur de contenu</span>
          <h2 id="h-liste">Les créateurs</h2>
        </div>
      </div>
      <ul class="grille-av" role="list">
        {
          createurs.map((c, i) => (
            <li>
              <CarteArtiste
                href={`/createurs/${c.id}/`}
                nom={c.data.nom}
                sousTitre={sousTitreCreateur(c)}
                initiales={c.data.initiales}
                portrait={c.data.portrait}
                variante={i}
              >
                {c.data.horaire && <StatutLive plages={c.data.horaire.plages} />}
              </CarteArtiste>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec-bandeaux" aria-labelledby="h-collab">
    <div class="wrap">
      <div class="bandeau">
        <div>
          <span class="mono">Collaborer</span>
          <h2 id="h-collab">Tu crées du contenu ?</h2>
          <p>Viens jaser avec l'équipe et la communauté sur le Discord de Studio Nord.</p>
        </div>
        <a class="btn btn-p" href={DISCORD} target="_blank" rel="noopener">
          Rejoindre le Discord <span aria-hidden="true">↗</span>
          <span class="sr">(nouvel onglet)</span>
        </a>
      </div>

      <p class="aussi">
        Tu cherches nos musiciens ?{' '}
        <a class="lien" href="/artistes/">Voir les artistes <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Page>

<style>
  section { padding: 32px 0; }

  /* Pastille « En live » dans une carte de 132 px : plus compacte, « selon l'horaire » dessous. */
  .grille-av :global(statut-live) {
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 6px;
    max-width: 132px;
    padding: 3px 10px;
    border-radius: 14px;
    font-size: .8rem;
  }
  .grille-av :global(statut-live .selon) {
    flex-basis: 100%;
    font-size: .72rem;
  }

  .sec-bandeaux { padding-bottom: 64px; }
  .bandeau {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px;
    border-radius: var(--r);
    border: 1px solid var(--ligne);
    background: linear-gradient(120deg, var(--marine), var(--abysse));
  }
  .bandeau .mono { color: var(--glace); }
  .bandeau h2 { margin: 6px 0; font-size: clamp(1.5rem, 4vw, 2.2rem); }
  .bandeau p { margin: 0; color: var(--doux); }
  .aussi {
    margin: 22px 0 0;
    color: var(--doux);
  }
</style>
