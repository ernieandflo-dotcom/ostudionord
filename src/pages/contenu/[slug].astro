---
// Page d'une sortie publiée (clip, coulisses, live…) : /contenu/<slug>/
// Phase : P1 (étape c)
//
// getStaticPaths() crée une page par fichier de src/content/sorties/ dont statut = publiee.
// Le slug est le nom du fichier : porter-ton-nom.md → /contenu/porter-ton-nom/.
// Les sorties à venir n'ont pas de page : leur tuile mène à l'infolettre.
//
// Contenu : lecteur (YouTube ou R2), type et date, titre, artistes et créateurs liés,
// résumé, texte libre du .md (s'il y en a), épisodes du même regroupement (`serie`),
// « À voir aussi », retour au mur. Données structurées VideoObject pour Google.
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LecteurYouTube from '../../components/LecteurYouTube.astro';
import LecteurVideo from '../../components/LecteurVideo.astro';
import Tuile from '../../components/Tuile.astro';
import { media } from '../../data/site';
import {
  LIBELLES,
  aUnePage,
  aVoirAussi,
  episodes,
  formaterDate,
  personnes,
  titreSerie,
  type Sortie,
} from '../../lib/sorties';

export async function getStaticPaths() {
  const sorties = await getCollection('sorties', aUnePage);
  return sorties.map((sortie) => ({ params: { slug: sortie.id }, props: { sortie } }));
}

interface Props {
  sortie: Sortie;
}

const { sortie } = Astro.props;
const d = sortie.data;

const publiees = await getCollection('sorties', aUnePage);
const avec = await personnes(sortie);
const noms = avec.map((p) => p.nom).join(' X ');
const serie = episodes(sortie, publiees);
const suggestions = aVoirAussi(sortie, publiees);

// Texte libre sous le frontmatter (crédits, réalisation…), rendu en HTML.
const { Content } = await render(sortie);
const aDuTexte = Boolean(sortie.body?.trim());

const libelle = LIBELLES[d.type];
const vertical = d.vignette ? d.vignette.height > d.vignette.width : false;
// Description (SEO et partage) : le résumé, sinon une phrase générée, ex.
// « 199 2e Avenue, QC, Limoilou : coulisses (Décompte · J-2), par Studio Nord à Limoilou. »
const description =
  d.resume ??
  `${d.titre} : ${libelle.un.toLowerCase()}${d.legende ? ` (${d.legende})` : ''}` +
    `${noms ? ` avec ${noms}` : ''}, par Studio Nord à Limoilou.`;
const titrePage = noms ? `${d.titre} — ${noms}` : d.titre;

const srcVideo = d.videoR2 ? media(d.videoR2) : undefined;
const srcSousTitres = d.sousTitresR2 ? media(d.sousTitresR2) : undefined;

// ---------- Données structurées (JSON-LD, schema.org VideoObject) ----------
// Décrit la vidéo à Google : nom, description, vignette, date, adresse de lecture.
// Toutes les URL doivent être absolues.
const absolu = (u: string) => new URL(u, Astro.site).href;
let jsonLd: string | undefined;
if ((d.youtubeId || srcVideo) && d.vignette && d.date) {
  const vignetteLd = await getImage({
    src: d.vignette,
    width: Math.min(d.vignette.width, 1280),
    format: 'jpg',
  });
  const video = {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: d.titre,
    description,
    thumbnailUrl: [absolu(vignetteLd.src)],
    uploadDate: d.date.toISOString(),
    inLanguage: 'fr-CA',
    url: absolu(Astro.url.pathname),
    ...(d.youtubeId
      ? { embedUrl: `https://www.youtube.com/embed/${d.youtubeId}` }
      : { contentUrl: absolu(srcVideo!) }),
    ...(avec.length > 0 && {
      actor: avec.map((p) => ({ '@type': 'Person', name: p.nom, url: absolu(p.href) })),
    }),
    publisher: { '@type': 'Organization', name: 'Studio Nord', url: absolu('/') },
  };
  // « < » échappé : le texte ne peut pas fermer la balise <script> par accident.
  jsonLd = JSON.stringify(video).replace(/</g, '\\u003c');
}
---

<Base
  title={titrePage}
  description={description}
  image={d.vignette}
  imageAlt={d.vignetteAlt}
  type="article"
  publie={d.date}
>
  {jsonLd && (
    <Fragment slot="head">
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    </Fragment>
  )}

  <article class="sortie" aria-labelledby="h-sortie">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'Ariane">
        <a href="/contenu/"><span aria-hidden="true">← </span>Tout le contenu</a>
      </nav>

      <div class:list={['grille', { vertical }]}>
        <!-- Lecteur -->
        <div class="media">
          {
            d.youtubeId && d.vignette ? (
              <LecteurYouTube id={d.youtubeId} titre={d.titre} vignette={d.vignette} prioritaire />
            ) : srcVideo && d.vignette ? (
              <LecteurVideo
                src={srcVideo}
                titre={d.titre}
                vignette={d.vignette}
                sousTitres={srcSousTitres}
              />
            ) : d.vignette ? (
              <Image
                class="image-seule"
                src={d.vignette}
                alt={d.vignetteAlt ?? ''}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1240px) 1200px, 100vw"
                priority
              />
            ) : (
              <div class="degrade" aria-hidden="true" />
            )
          }
        </div>

        <!-- Infos -->
        <div class="infos">
          <p class="mono meta">
            <span class="badge">{libelle.un}</span>
            {d.date && <time datetime={d.date.toISOString().slice(0, 10)}>{formaterDate(d.date)}</time>}
            {d.legende && <span>{d.legende}</span>}
          </p>

          <h1 id="h-sortie">{d.titre}</h1>

          {
            avec.length > 0 && (
              <div class="avec">
                <span class="mono etiquette" id="h-avec">Avec</span>
                <ul role="list" aria-labelledby="h-avec">
                  {avec.map((p) => (
                    <li>
                      <a class="pers" href={p.href}>
                        <span class="ini" aria-hidden="true">{p.initiales}</span>
                        {p.nom}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {d.resume && <p class="resume">{d.resume}</p>}

          {
            aDuTexte && (
              <div class="texte">
                <Content />
              </div>
            )
          }

          <!-- Épisodes du même regroupement (ex. le décompte) -->
          {
            serie.length > 1 && d.serie && (
              <section class="serie" aria-labelledby="h-serie">
                <div class="serie-h">
                  <h2 id="h-serie">{titreSerie(d.serie)}</h2>
                  <span class="mono">
                    {serie.findIndex((e) => e.id === sortie.id) + 1} sur {serie.length}
                  </span>
                </div>
                <ol role="list">
                  {serie.map((e, i) => {
                    const actuel = e.id === sortie.id;
                    return (
                      <li>
                        <a href={`/contenu/${e.id}/`} aria-current={actuel ? 'page' : undefined}>
                          <span class="th">
                            {e.data.vignette && (
                              <Image src={e.data.vignette} alt="" width={96} quality="mid" />
                            )}
                          </span>
                          <span>
                            <small class="mono">{e.data.legende ?? `Épisode ${i + 1}`}</small>
                            <strong>{e.data.titre}</strong>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ol>
              </section>
            )
          }
        </div>
      </div>
    </div>
  </article>

  <!-- À voir aussi -->
  {
    suggestions.length > 0 && (
      <section class="sec-aussi" aria-labelledby="h-aussi">
        <div class="wrap">
          <div class="sec-h">
            <div>
              <span class="mono">Continuer</span>
              <h2 id="h-aussi">À voir aussi</h2>
            </div>
          </div>
          <div class="mur">
            {suggestions.map((s) => (
              <Tuile sortie={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Retour au mur -->
  <nav class="retour" aria-label="Retour au mur de contenu">
    <div class="wrap">
      <a class="btn btn-p" href="/contenu/">Voir tout le contenu</a>
      <a class="btn btn-g" href={`/contenu/?type=${d.type}`}>
        Plus de {libelle.plusieurs.toLowerCase()}
      </a>
    </div>
  </nav>
</Base>

<style>
  .sortie { padding: 18px 0 8px; }

  .fil { margin-bottom: 14px; }
  .fil a {
    color: var(--doux);
    font-size: .92rem;
    text-decoration: none;
  }
  .fil a:hover { color: var(--glace); }

  .grille {
    display: grid;
    gap: 22px;
  }
  /* Vidéo verticale sur ordinateur : lecteur à gauche, texte à droite. */
  @media (min-width: 900px) {
    .grille.vertical {
      grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
      gap: 40px;
      align-items: start;
    }
  }
  .infos { max-width: 46rem; }

  .image-seule {
    width: 100%;
    border-radius: var(--r);
    border: 1px solid var(--ligne);
  }
  .degrade {
    aspect-ratio: 16 / 9;
    border-radius: var(--r);
    background:
      radial-gradient(70% 60% at 50% 30%, rgba(0, 158, 226, .45), transparent),
      linear-gradient(180deg, var(--abysse), var(--marine));
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0 0 10px;
    color: var(--doux);
  }
  .badge {
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--survol);
    color: var(--glace);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.6rem);
    line-height: .95;
    font-weight: 800;
    font-variation-settings: "wdth" 80;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
  }

  .avec {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
  }
  .etiquette { color: var(--cyan); }
  .avec ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pers {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 4px 14px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--ligne);
    color: var(--texte);
    font-weight: 600;
    font-size: .92rem;
    text-decoration: none;
  }
  .pers:hover { border-color: var(--cyan); }
  .ini {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(160deg, var(--cyan), var(--marine));
    color: var(--texte);
    font-family: var(--mono);
    font-size: .7rem;
  }

  .resume {
    margin: 18px 0 0;
    color: var(--doux);
    font-size: 1.08rem;
  }
  .texte {
    margin-top: 18px;
    color: var(--doux);
  }
  .texte :global(a) { color: var(--glace); }

  /* Épisodes */
  .serie {
    margin-top: 28px;
    padding: 16px;
    border-radius: var(--r);
    border: 1px solid var(--ligne);
    background: var(--carte);
  }
  .serie-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 8px;
  }
  .serie-h h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .serie-h .mono { color: var(--doux); flex: none; }
  .serie ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .serie a {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    align-items: center;
    padding: 6px;
    border-radius: 12px;
    color: var(--texte);
    text-decoration: none;
  }
  .serie a:hover { background: var(--survol); }
  .serie a[aria-current="page"] {
    background: var(--survol);
    box-shadow: inset 3px 0 0 var(--cyan);
  }
  .th {
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--bleu), var(--marine));
  }
  .th :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .serie small {
    display: block;
    color: var(--doux);
    font-size: .68rem;
  }
  .serie strong {
    display: block;
    font-size: .95rem;
    line-height: 1.2;
  }

  .sec-aussi { padding-bottom: 24px; }

  .retour { padding: 8px 0 64px; }
  .retour .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
