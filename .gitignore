# Dépendances et sorties de build
node_modules/
dist/
.astro/

# Variables d'environnement (garder .env.example)
.env
.env.*
!.env.example

# Système et éditeur
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*

# Médias lourds : les vidéos vivent dans R2, jamais dans le dépôt
*.mp4
*.MP4
*.mov
*.MOV
*.webm
*.heic
*.HEIC

# Repli local des médias R2 (copie de travail, non versionnée)
public/media/*
!public/media/.gitkeep

# Fichiers sources bruts pour scripts/convertir_medias.py
medias-sources/
